{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "text",
        "sources"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "institution": {
          "minLength": 1,
          "title": "Institution",
          "type": "string"
        },
        "qualification": {
          "minLength": 1,
          "title": "Qualification",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "start_date": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "End Date",
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "institution",
        "qualification",
        "field",
        "start_date",
        "end_date",
        "sources"
      ],
      "title": "Education",
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "company": {
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "employment_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employment Type"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "start_date": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Date"
        },
        "current": {
          "title": "Current",
          "type": "boolean"
        },
        "date_review_required": {
          "default": false,
          "title": "Date Review Required",
          "type": "boolean"
        },
        "bullets": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Bullets",
          "type": "array"
        },
        "skills": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "company",
        "role",
        "start_date",
        "end_date",
        "current",
        "bullets",
        "skills",
        "sources",
        "order"
      ],
      "title": "Experience",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "category": {
          "enum": [
            "web",
            "ai-ml",
            "agents",
            "cli",
            "data",
            "open-source"
          ],
          "title": "Category",
          "type": "string"
        },
        "repo_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Repo Url",
          "type": "string"
        },
        "live_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Live Url"
        },
        "contribution_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contribution Url"
        },
        "bullets": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Bullets",
          "type": "array"
        },
        "tags": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "featured": {
          "default": false,
          "title": "Featured",
          "type": "boolean"
        },
        "status": {
          "const": "draft",
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "editorial_status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved"
          ],
          "title": "Editorial Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "repo_url",
        "bullets",
        "tags",
        "sources"
      ],
      "title": "Project",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "entity": {
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "disposition": {
          "default": "pending",
          "enum": [
            "pending",
            "deferred",
            "resolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        }
      },
      "required": [
        "id",
        "entity",
        "question",
        "evidence"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "SiteSettings": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "site_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Site Url",
          "type": "string"
        },
        "email": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "title": "Email",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "target_tracks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Tracks",
          "type": "array"
        },
        "bio": {
          "$ref": "#/$defs/Claim"
        },
        "resume_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume Url"
        }
      },
      "required": [
        "name",
        "site_url",
        "email",
        "location",
        "target_tracks",
        "bio"
      ],
      "title": "SiteSettings",
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "group": {
          "minLength": 1,
          "title": "Group",
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "name",
        "group",
        "sources"
      ],
      "title": "Skill",
      "type": "object"
    },
    "SocialLink": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "href": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Href",
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "label",
        "href",
        "sources"
      ],
      "title": "SocialLink",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "resume",
          "enum": [
            "resume",
            "owner_response",
            "github_file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pages"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "git_blob_sha": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Blob Sha"
        }
      },
      "required": [
        "id",
        "filename",
        "sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "review_status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "site_settings": {
      "$ref": "#/$defs/SiteSettings"
    },
    "social_links": {
      "items": {
        "$ref": "#/$defs/SocialLink"
      },
      "title": "Social Links",
      "type": "array"
    },
    "experience": {
      "items": {
        "$ref": "#/$defs/Experience"
      },
      "title": "Experience",
      "type": "array"
    },
    "education": {
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/Project"
      },
      "title": "Projects",
      "type": "array"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/Skill"
      },
      "title": "Skills",
      "type": "array"
    },
    "review_issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "title": "Review Issues",
      "type": "array"
    }
  },
  "required": [
    "sources",
    "site_settings",
    "social_links",
    "experience",
    "education",
    "projects",
    "skills",
    "review_issues"
  ],
  "title": "ContentSeed",
  "type": "object"
}
